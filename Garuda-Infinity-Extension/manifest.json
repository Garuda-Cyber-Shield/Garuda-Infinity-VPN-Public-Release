{
  "manifest_version": 3,
  "name": "Garuda Infinity",
  "short_name": "Garuda Infinity",
  "version": "1.1.0",
  "description": "Garuda Infinity V1.1.0 — Global 3D Browser VPN & Encrypted Proxy Extension with 82+ Countries and 4K Streaming by Garuda Cyber Shield.",
  "author": "QUICKSILVER",
  "key": "",
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Garuda Infinity — V1.1.0",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; img-src 'self' data: https:; connect-src 'self' https:;"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
